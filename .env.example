# ==============================================================================
# MULTILINGUAL AI DOCUMENT ASSISTANT — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and adjust values for local development.
# ==============================================================================

# --- Application Settings ---
APP_NAME="Multilingual AI Document Assistant"
APP_ENV=development
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Relational Application Database (SQLite) ---
DATABASE_URL="sqlite+aiosqlite:///./data/app.db"

# --- Vector Store & Embeddings ---
VECTOR_STORE_TYPE=chroma
VECTOR_STORE_PATH="./data/vector_store/chroma"
VECTOR_COLLECTION_NAME="institutional_documents_v1"
EMBEDDING_MODEL_NAME="intfloat/multilingual-e5-small"
EMBEDDING_DIMENSION=384
SIMILARITY_THRESHOLD=0.65
TOP_K_CHUNKS=5

# --- Multilingual Query Processing & Expansion (Phase 6) ---
RETRIEVAL_ENABLE_QUERY_EXPANSION=true
RETRIEVAL_MAX_QUERY_VARIANTS=4
RETRIEVAL_MAX_EXPANSION_TERMS=8
RETRIEVAL_ENABLE_TRANSLITERATION=true
RETRIEVAL_VARIANT_WEIGHT=0.85

# --- LLM Generation Engine ---
# Primary provider: 'gemini' (Hosted Free Tier API), 'groq', or 'ollama' (Local)
LLM_PRIMARY_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=ollama
LLM_MODEL_NAME="gemini-1.5-flash"
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=15

# API Keys (Provide your free Google Gemini API key)
GEMINI_API_KEY=""
GROQ_API_KEY=""

# Local Ollama Settings (for 100% Offline Mode)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL_NAME="llama3.2:3b-instruct-q4_K_M"

# --- Security & Administrator Authentication ---
# Secret key used for signing session tokens (Change in production!)
ADMIN_TOKEN_SECRET="dev-insecure-secret-key-change-in-production-min32chars"
ADMIN_TOKEN_EXPIRY_MINUTES=480
ADMIN_DEFAULT_USERNAME="admin"
ADMIN_DEFAULT_PASSWORD="admin_password_change_me"

# --- Logging & Big Data Telemetry ---
LOG_LEVEL=INFO
TELEMETRY_ENABLED=true
TELEMETRY_DIRECTORY="./data/telemetry"
TELEMETRY_LOG_ROTATION_MB=25

# --- PySpark Analytics Engine ---
SPARK_MASTER="local[*]"
SPARK_APP_NAME="InstitutionalDocAnalytics"
SPARK_DRIVER_MEMORY="2g"
